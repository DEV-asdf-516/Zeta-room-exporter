{
  "manifest_version": 3,
  "name": "Zeta Room Exporter",
  "version": "1.1.0",
  "description": "Export resumable Zeta room ranges and add message bookmarks from the context menu.",
  "permissions": [
    "cookies",
    "downloads",
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://zeta-ai.io/*",
    "https://api.zeta-ai.io/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://zeta-ai.io/*"],
      "js": ["src/content/message-context.js", "src/content/content-script.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Zeta Room Exporter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup/popup.html"
  }
}
