{
  "manifest_version": 3,
  "name": "Zeta Room Exporter",
  "version": "1.0.1",
  "description": "Export the current Zeta AI room to JSON or TXT.",
  "permissions": [
    "cookies",
    "downloads",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://zeta-ai.io/*",
    "https://api.zeta-ai.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Zeta Room Exporter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}